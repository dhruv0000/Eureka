```python
import torch
from typing import Tuple, Dict

@torch.jit.script
def compute_reward(
    object_rot: torch.Tensor,       # [num_envs, 4]
    goal_rot: torch.Tensor,         # [num_envs, 4]
    object_angvel: torch.Tensor,    # [num_envs, 3]
    object_linvel: torch.Tensor,    # [num_envs, 3]
    actions: torch.Tensor,          # [num_envs, num_actions]
    object_pos: torch.Tensor,       # [num_envs, 3]
    fingertip_pos: torch.Tensor,    # [num_envs, num_fingertips, 3]
) -> Tuple[torch.Tensor, Dict[str, torch.Tensor]]:
    # Analysis-based changes:
    # - Previous orientation shaping exp(-temp * error) saturated near zero (ori_rew ~0.03) and gave almost no gradient.
    #   Use normalized angle and lower temperature to keep signal across full range.
    # - Angular alignment had tiny temperature and barely changed; strengthen with progress-based shaping and direction cosine.
    # - Speed/linvel/action penalties were negligible; rescale and add a speed matching term + settle penalty near goal.
    # - Add a contact reward using fingertip distances to encourage grasp stability while spinning.

    # Temperatures for transformed components
    ori_temp: float = 4.0        # orientation shaping temperature on normalized angle
    progress_temp: float = 0.3   # tanh shaping for angular progress
    speed_temp: float = 3.0      # exp shaping for speed match error
    contact_temp: float = 4.0    # exp shaping for fingertip proximity
    settle_temp: float = 8.0     # exp gate to penalize angular speed when close

    # Weights for components
    w_ori: float = 2.0
    w_progress: float = 1.5
    w_align_dir: float = 1.0
    w_speed_match: float = 1.2
    w_contact: float = 0.5
    w_settle_pen: float = 0.2
    w_linvel_pen: float = 0.05
    w_action_pen: float = 0.01

    # Success bonus parameters
    success_threshold: float = 0.10  # radians
    settle_speed_thresh: float = 0.20  # rad/s
    success_bonus_val: float = 1.0

    # Misc constants
    eps: float = 1e-6
    small: float = 1e-5
    pi_t: float = 3.141592653589793

    device = object_rot.device
    dtype = object_rot.dtype

    # Normalize quaternions to be safe
    obj_norm = torch.sqrt(torch.sum(object_rot * object_rot, dim=1) + eps)
    goal_norm = torch.sqrt(torch.sum(goal_rot * goal_rot, dim=1) + eps)
    q_obj = object_rot / obj_norm.unsqueeze(1)
    q_goal = goal_rot / goal_norm.unsqueeze(1)

    # Quaternion parts
    v_obj = q_obj[:, 0:3]
    w_obj = q_obj[:, 3]
    v_goal = q_goal[:, 0:3]
    w_goal = q_goal[:, 3]

    # Error quaternion q_err = q_goal * conj(q_obj)
    v_conj = -v_obj
    w_conj = w_obj
    cross = torch.cross(v_goal, v_conj, dim=1)
    dotvv = torch.sum(v_goal * v_conj, dim=1)
    v_err = w_goal.unsqueeze(1) * v_conj + w_conj.unsqueeze(1) * v_goal + cross
    w_err = w_goal * w_conj - dotvv

    # Normalize error quaternion
    q_err_norm = torch.sqrt(torch.sum(v_err * v_err, dim=1) + w_err * w_err + eps)
    v_err = v_err / q_err_norm.unsqueeze(1)
    w_err = w_err / q_err_norm

    # Flip to shortest-arc quaternion (ensure scalar part non-negative)
    neg_one = torch.tensor(-1.0, device=device, dtype=dtype)
    pos_one = torch.tensor(1.0, device=device, dtype=dtype)
    sign = torch.where(w_err < 0.0, neg_one, pos_one)
    v_err = v_err * sign.unsqueeze(1)
    w_err = w_err * sign

    # Axis-angle from error quaternion
    w_clamped = torch.clamp(w_err, 0.0, 1.0)
    angle = 2.0 * torch.acos(w_clamped)
    sin_half = torch.sqrt(torch.clamp(1.0 - w_clamped * w_clamped, min=0.0))
    denom = sin_half + eps
    axis = v_err / denom.unsqueeze(1)
    # Zero axis when angle ~0 to avoid numerical issues
    mask = (sin_half > small).to(dtype)
    axis = axis * mask.unsqueeze(1)

    # Normalized angle in [0, 1]
    pi_tensor = torch.tensor(pi_t, device=device, dtype=dtype)
    angle_norm = angle / pi_tensor

    # Orientation alignment shaping (0..1)
    ori_rew = torch.exp(-ori_temp * angle_norm)

    # Angular velocity magnitude and direction
    w_mag = torch.sqrt(torch.sum(object_angvel * object_angvel, dim=1) + eps)

    # Direction cosine alignment in [-1,1] mapped to [0,1], weighted by angle_norm
    dir_cos = torch.sum(axis * object_angvel, dim=1) / (w_mag + eps)
    dir_align = 0.5 * (dir_cos + pos_one) * angle_norm  # encourage alignment more when far

    # Progress shaping: positive when rotating along the error axis to reduce angle
    progress_raw = torch.sum(axis * object_angvel, dim=1) * angle_norm
    progress_tanh = torch.tanh(progress_temp * progress_raw)
    progress_rew = 0.5 * (progress_tanh + pos_one)  # map to [0,1]

    # Speed matching: target angular speed proportional to error angle
    speed_gain: float = 4.0  # desired rad/s per rad of error
    w_desired = speed_gain * angle
    speed_err_norm = torch.abs(w_mag - w_desired) / (w_desired + 1e-3)
    speed_match = torch.exp(-speed_temp * speed_err_norm) * angle_norm  # focus when far, fade near goal

    # Penalize angular speed when close to target (settling)
    settle_gate = torch.exp(-settle_temp * angle_norm)
    settle_pen = w_mag * settle_gate

    # Penalize object linear velocity (keep object stable)
    lin_mag = torch.sqrt(torch.sum(object_linvel * object_linvel, dim=1) + eps)
    lin_pen = lin_mag

    # Encourage fingertips close to object (grasp stability)
    # fingertip_pos: [N, F, 3], object_pos: [N, 3]
    obj_pos_unsq = object_pos.unsqueeze(1)  # [N, 1, 3]
    ft_diff = fingertip_pos - obj_pos_unsq
    ft_dist = torch.sqrt(torch.sum(ft_diff * ft_diff, dim=2) + eps)  # [N, F]
    avg_ft_dist = torch.mean(ft_dist, dim=1)  # [N]
    contact_rew = torch.exp(-contact_temp * avg_ft_dist)

    # Action penalty (smooth control)
    act_pen = torch.mean(actions * actions, dim=1)

    # Success bonus when orientation is close and angular speed is low (stable)
    thr_t = torch.tensor(success_threshold, device=device, dtype=dtype)
    speed_thr_t = torch.tensor(settle_speed_thresh, device=device, dtype=dtype)
    bonus_t = torch.tensor(success_bonus_val, device=device, dtype=dtype)
    success_mask = ((angle < thr_t) & (w_mag < speed_thr_t)).to(dtype)
    success_bonus = success_mask * bonus_t

    # Total reward
    total = (
        w_ori * ori_rew
        + w_progress * progress_rew
        + w_align_dir * dir_align
        + w_speed_match * speed_match
        + w_contact * contact_rew
        - w_settle_pen * settle_pen
        - w_linvel_pen * lin_pen
        - w_action_pen * act_pen
        + success_bonus
    )

    components: Dict[str, torch.Tensor] = {
        "ori_rew": w_ori * ori_rew,
        "progress_rew": w_progress * progress_rew,
        "dir_align": w_align_dir * dir_align,
        "speed_match": w_speed_match * speed_match,
        "contact_rew": w_contact * contact_rew,
        "settle_penalty": -w_settle_pen * settle_pen,
        "linvel_penalty": -w_linvel_pen * lin_pen,
        "action_penalty": -w_action_pen * act_pen,
        "success_bonus": success_bonus,
        "angle": angle,
        "angle_norm": angle_norm,
        "total": total,
    }
    return total, components
```

