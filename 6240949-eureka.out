```python
import torch
from typing import Tuple, Dict

@torch.jit.script
def compute_reward(
    object_rot: torch.Tensor,
    goal_rot: torch.Tensor,
    object_pos: torch.Tensor,
    goal_pos: torch.Tensor,
    object_angvel: torch.Tensor,
    object_linvel: torch.Tensor,
    actions: torch.Tensor,
) -> Tuple[torch.Tensor, Dict[str, torch.Tensor]]:
    # Safety constants and temperatures (each transformed component has its own temperature)
    eps: float = 1e-6
    temp_orient: float = 0.5        # rad, sharper orientation shaping with smaller value
    temp_pos: float = 0.02          # m, encourage staying near goal position (if applicable)
    temp_gate: float = 0.3          # rad, gates stabilization vs. speed
    temp_angvel: float = 1.5        # rad/s, stabilization of angular velocity near goal
    temp_fast: float = 2.0          # rad/s, encourages rotation speed when far from goal
    temp_action: float = 2.0        # action units, smoothness
    temp_linvel: float = 0.1        # m/s, stabilize linear velocity near goal

    # Weights
    w_orient: float = 2.0
    w_pos: float = 0.2
    w_stable_ang: float = 0.5
    w_stable_lin: float = 0.1
    w_spin_fast: float = 0.1
    w_smooth: float = 0.05

    # Success bonus
    angle_success_thresh: float = 0.1  # rad (~6 deg)
    success_bonus_scale: float = 1.0

    # Normalize quaternions to be safe
    q1 = object_rot
    q2 = goal_rot
    q1_norm = torch.clamp(torch.norm(q1, dim=-1, keepdim=True), min=eps)
    q2_norm = torch.clamp(torch.norm(q2, dim=-1, keepdim=True), min=eps)
    q1n = q1 / q1_norm
    q2n = q2 / q2_norm

    # Quaternion distance: angle between orientations (shortest-arc, ignore antipodal)
    dot = torch.sum(q1n * q2n, dim=-1)
    dot_abs = torch.abs(dot)
    dot_clamped = torch.clamp(dot_abs, 0.0, 1.0 - eps)
    angle_err = 2.0 * torch.acos(dot_clamped)  # in [0, pi]

    # Position error (if position matters to keep object near goal position)
    pos_err = torch.norm(object_pos - goal_pos, dim=-1)

    # Velocity norms
    angvel_norm = torch.norm(object_angvel, dim=-1)
    linvel_norm = torch.norm(object_linvel, dim=-1)

    # Gating based on orientation error: near target -> stabilize, far -> allow speed
    gate_near = torch.exp(-angle_err / temp_gate)  # in (0,1], higher when near target
    far_factor = 1.0 - gate_near                    # higher when far from target

    # Reward components (using exponential shaping with temperatures)
    r_orient = torch.exp(-angle_err / temp_orient)
    r_pos = torch.exp(-pos_err / temp_pos)

    # Stabilize angular and linear velocity when near the target orientation
    r_stable_ang = gate_near * torch.exp(-angvel_norm / temp_angvel)
    r_stable_lin = gate_near * torch.exp(-linvel_norm / temp_linvel)

    # Encourage spinning faster when far from the target (but fades as we get closer)
    r_spin_fast = far_factor * (1.0 - torch.exp(-angvel_norm / temp_fast))

    # Smooth actions to reduce jitter
    act_norm = torch.norm(actions, dim=-1)
    r_smooth = torch.exp(-act_norm / temp_action)

    # Success bonus when within threshold
    success_mask = (angle_err < angle_success_thresh)
    success_bonus = success_bonus_scale * success_mask.to(angle_err.dtype)

    # Total reward
    total_reward = (
        w_orient * r_orient
        + w_pos * r_pos
        + w_stable_ang * r_stable_ang
        + w_stable_lin * r_stable_lin
        + w_spin_fast * r_spin_fast
        + w_smooth * r_smooth
        + success_bonus
    )

    # Components dictionary
    components: Dict[str, torch.Tensor] = {
        "r_orient": r_orient,
        "r_pos": r_pos,
        "r_stable_ang": r_stable_ang,
        "r_stable_lin": r_stable_lin,
        "r_spin_fast": r_spin_fast,
        "r_smooth": r_smooth,
        "success_bonus": success_bonus,
        "angle_err": angle_err,
        "pos_err": pos_err,
        "angvel_norm": angvel_norm,
        "linvel_norm": linvel_norm,
        "act_norm": act_norm,
        "gate_near": gate_near,
        "far_factor": far_factor,
        "total": total_reward,
    }

    return total_reward, components
```

